{
  "meta": {
    "theme": "dark",
    "reference_resolution": [
      1920,
      1080
    ],
    "min_resolution": [
      1280,
      720
    ],
    "grid": 8,
    "scale_policy": "proportional",
    "density": "comfortable",
    "interaction_design": "v2",
    "spectrum": "visible_only"
  },
  "color": {
    "bg_base": "#0E1116",
    "bg_sunken": "#0A0D11",
    "surface": "#161B22",
    "surface_elev": "#1F2630",
    "surface_hover": "#232B36",
    "border": "#2D3644",
    "border_strong": "#3A4552",
    "overlay_scrim": "rgba(6,9,12,0.72)",
    "text_primary": "#E6EDF3",
    "text_secondary": "#9BA7B4",
    "text_muted": "#6E7A88",
    "text_disabled": "#4C5764",
    "text_on_solid": "#FFFFFF",
    "accent": "#3B82F6",
    "accent_hover": "#2F6FE0",
    "accent_pressed": "#2563C9",
    "focus_ring": "#58A6FF",
    "link": "#79B8FF",
    "ok": "#3FB950",
    "ok_bg": "#12261A",
    "info": "#4C9AFF",
    "info_bg": "#12203A",
    "degraded": "#E3B341",
    "degraded_bg": "#2A2312",
    "error": "#E5484D",
    "error_fg": "#FF6B6B",
    "error_bg": "#331114",
    "neutral": "#8B949E",
    "neutral_bg": "#1B2027",
    "debug_box": "#00E5FF",
    "debug_roi": "#FFD400"
  },
  "alarm": {
    "L1": {
      "label": "一级",
      "glyph": "triangle",
      "accent": "#FF6B6B",
      "solid_bg": "#C42B1C",
      "tint_bg": "#3A1518",
      "border": "#E5484D",
      "text_on_solid": "#FFFFFF",
      "sound": "required",
      "pulse_hz": 1.5,
      "persist": "until_ack"
    },
    "L2": {
      "label": "二级",
      "glyph": "circle",
      "accent": "#F0883E",
      "solid_bg": "#B45309",
      "tint_bg": "#3A2612",
      "border": "#F0883E",
      "text_on_solid": "#FFFFFF",
      "sound": "short",
      "pulse_hz": 0,
      "persist": "until_dismiss_or_ack"
    },
    "L3": {
      "label": "三级",
      "glyph": "diamond",
      "accent": "#E3B341",
      "solid_bg": "#8A6D00",
      "tint_bg": "#332A12",
      "border": "#E3B341",
      "text_on_solid": "#FFFFFF",
      "sound": "none",
      "pulse_hz": 0,
      "persist": "auto_dismiss_10s"
    }
  },
  "stream_state": {
    "live": {
      "label": "在线",
      "fg": "#3FB950",
      "bg": "#12261A",
      "glyph": "dot",
      "placeholder": false
    },
    "connecting": {
      "label": "连接中",
      "fg": "#4C9AFF",
      "bg": "#12203A",
      "glyph": "spinner",
      "placeholder": true
    },
    "reconnecting": {
      "label": "重连中",
      "fg": "#4C9AFF",
      "bg": "#12203A",
      "glyph": "spinner",
      "placeholder": true
    },
    "frozen": {
      "label": "画面冻结",
      "fg": "#E3B341",
      "bg": "#2A2312",
      "glyph": "snowflake",
      "placeholder": true
    },
    "degraded": {
      "label": "画面降级",
      "fg": "#E3B341",
      "bg": "#2A2312",
      "glyph": "warning",
      "placeholder": false
    },
    "offline": {
      "label": "离线",
      "fg": "#FF6B6B",
      "bg": "#331114",
      "glyph": "slash",
      "placeholder": true
    }
  },
  "mode": {
    "visible": {
      "label": "可见光",
      "fg": "#8B949E",
      "bg": "#1B2027",
      "glyph": "dot",
      "interactive": false
    },
    "ir": {
      "label": "红外未接入",
      "fg": "#4C5764",
      "bg": "transparent",
      "glyph": "slash",
      "interactive": false
    }
  },
  "integration_state": {
    "probing": {
      "label": "探测中",
      "fg": "#4C9AFF",
      "bg": "#12203A",
      "glyph": "spinner"
    },
    "reachable": {
      "label": "可达",
      "fg": "#3FB950",
      "bg": "#12261A",
      "glyph": "dot"
    },
    "unreachable": {
      "label": "不可达",
      "fg": "#FF6B6B",
      "bg": "#331114",
      "glyph": "slash"
    },
    "unconfigured": {
      "label": "未配置",
      "fg": "#8B949E",
      "bg": "#1B2027",
      "glyph": "minus"
    },
    "unverified": {
      "label": "未核验",
      "fg": "#8B949E",
      "bg": "#1B2027",
      "glyph": "help"
    }
  },
  "detection_badge": {
    "base": {
      "fg": "#9BA7B4",
      "bg": "#1B2027"
    },
    "none": {
      "fg": "#6E7A88",
      "bg": "#1B2027",
      "label": "广角·无检测"
    },
    "profiles": [
      "前方障碍/人员",
      "受电弓三状态",
      "轮轨",
      "车门",
      "广角·无检测"
    ]
  },
  "typography": {
    "family": {
      "ui": "\"Noto Sans CJK SC\",\"Source Han Sans SC\",\"WenQuanYi Micro Hei\",\"Noto Sans\",sans-serif",
      "mono": "\"Noto Sans Mono\",\"DejaVu Sans Mono\",monospace"
    },
    "scale": {
      "display": {
        "size": 32,
        "line": 40,
        "weight": 700
      },
      "h1": {
        "size": 24,
        "line": 32,
        "weight": 700
      },
      "h2": {
        "size": 20,
        "line": 28,
        "weight": 500
      },
      "body_lg": {
        "size": 18,
        "line": 26,
        "weight": 400
      },
      "body": {
        "size": 16,
        "line": 24,
        "weight": 400
      },
      "label": {
        "size": 14,
        "line": 20,
        "weight": 500
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 400
      }
    },
    "min_driver_text": 16,
    "min_alarm_title": 24,
    "numeral": "mono"
  },
  "spacing": {
    "s0": 0,
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 24,
    "s6": 32,
    "s7": 48,
    "s8": 64,
    "safe_area": {
      "1920x1080": 24,
      "1280x720": 16
    }
  },
  "radius": {
    "chip": 4,
    "button": 6,
    "card": 8,
    "panel": 8,
    "modal": 12,
    "pill": 999
  },
  "border": {
    "width": 1,
    "width_emphasis": 2,
    "alarm_width": 3
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(0,0,0,0.4)",
    "2": "0 4px 12px rgba(0,0,0,0.5)",
    "3": "0 12px 32px rgba(0,0,0,0.6)"
  },
  "radius_note": "border+表面层级优先于阴影",
  "size": {
    "top_bar_height": 48,
    "nav_width": 88,
    "status_strip_height": 64,
    "alarm_bar_height": 64,
    "touch_target_min": 44,
    "button": {
      "lg": 44,
      "md": 36,
      "sm": 32
    },
    "camera_tile": {
      "front_min_area_ratio": 0.34,
      "side_area_ratio": [
        0.22,
        0.3
      ]
    }
  },
  "motion": {
    "fast": "120ms",
    "normal": "200ms",
    "slow": "320ms",
    "easing": "cubic-bezier(0.2,0,0,1)",
    "pulse_min_hz": 1.0,
    "pulse_max_hz": 3.0,
    "reduce_motion": "respect_os_setting"
  },
  "z_index": {
    "base": 0,
    "camera_overlay": 10,
    "top_bar": 100,
    "nav": 100,
    "auto_popup": 300,
    "alarm_banner": 400,
    "modal": 500,
    "toast": 600
  },
  "icon": {
    "grid": 24,
    "stroke": 2,
    "style": "outline",
    "status_filled": true,
    "set_rule": "使用开源许可图标集（如 Lucide ISC / Material Symbols Apache-2.0）或项目自绘 SVG；须登记来源与许可，禁止未授权素材",
    "required_glyphs": [
      "camera",
      "camera-off",
      "bell",
      "replay-clock",
      "grid-6",
      "cpu-ai",
      "wrench",
      "check",
      "warning-triangle",
      "circle",
      "diamond",
      "play",
      "pause",
      "speed",
      "export",
      "lock",
      "user",
      "clock",
      "thermometer",
      "disk",
      "network",
      "server",
      "minus-circle",
      "chevron-left",
      "chevron-right",
      "close",
      "search",
      "filter"
    ]
  },
